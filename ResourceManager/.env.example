# Reference only; this file is not loaded automatically.
# API and worker must use the same local persistent manager database.
# RESOURCE_MANAGER_DB_PATH=/absolute/path/to/ResourceManager/data/resource-manager.sqlite3
RESOURCE_MANAGER_API_KEY=
# Defaults to the sibling Resources folder when omitted.
RESOURCE_MANAGER_RESOURCES_DIR=../Resources

# LLM providers, source papers, verification APIs, and application outcomes
# belong to clients. ResourceManager needs no domain-specific credentials.
